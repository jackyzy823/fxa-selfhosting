unified python and rust not_expire
python bso.ttl is int and set to ~0>>33
rust bso.ttl is bigint and set to ~0>>1

use
1) case
UPDATE sync.bso
SET ttl = CASE (
    SELECT DATA_TYPE
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'sync'
      AND TABLE_NAME = 'bso'
      AND COLUMN_NAME = 'ttl'
)
    WHEN 'bigint' THEN ~0 >> 1
    WHEN 'int'    THEN ~0 >> 33
END WHERE exists() and ttl != CASE (
    SELECT DATA_TYPE
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = 'sync'
      AND TABLE_NAME = 'bso'
      AND COLUMN_NAME = 'ttl'
)
    WHEN 'bigint' THEN ~0 >> 1
    WHEN 'int'    THEN ~0 >> 33
END
